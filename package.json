{
  "name": "wisp",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run back:dev front:dev",
    "back:dev": "turbo run back:dev --filter=@wisp/core",
    "front:dev": "turbo run front:dev --filter=@wisp/dashboard",
    "demo:dev": "turbo run demo:dev --filter=@wisp/demo",
    "demo:build": "turbo run demo:build --filter=@wisp/demo",
    "demo:deploy:local": "bun run demo:build && bunx serve apps/demo/dist/client -l 8787",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "semantic-release": "^24.2.0",
    "serve": "^14.2.4",
    "turbo": "^2.9.6",
    "typescript": "~5.9.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": ["apps/*", "packages/*"],
  "trustedDependencies": ["better-sqlite3"],
  "overrides": {
    "typescript": "~5.9.0",
    "ioredis": "5.10.1"
  }
}
