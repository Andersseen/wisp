{
  "name": "@wisp/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "DATABASE_URL=\"${DATABASE_URL:-../../apps/core/sqlite.db}\" drizzle-kit migrate",
    "db:seed": "DATABASE_URL=\"${DATABASE_URL:-../../apps/core/sqlite.db}\" bun run src/seed.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@wisp/typescript-config": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "bun-types": "^1.2.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "~5.9.0"
  }
}
