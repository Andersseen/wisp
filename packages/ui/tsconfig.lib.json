{
  "extends": "@wisp/typescript-config/angular.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "outDir": "./dist/out-tsc",
    "strict": true,
    "target": "ES2022",
    "useDefineForClassFields": false
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec.ts", "node_modules", "dist"]
}
