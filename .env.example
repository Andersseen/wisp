# Copy to .env — the backend refuses to start without a valid SESSION_SECRET.
# Validated by zod in apps/core/src/config/index.ts

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# SQLite file used by bun:sqlite (relative to apps/core cwd in dev)
DATABASE_URL=./sqlite.db

# Valkey (Redis-compatible) — started by infra/docker/dev.yml
VALKEY_URL=redis://localhost:6379

DOCKER_SOCKET=/var/run/docker.sock

# REQUIRED, min 32 chars. Generate: openssl rand -hex 32
SESSION_SECRET=

# Session cookie settings
SESSION_COOKIE_NAME=sessionId
SESSION_MAX_AGE_MS=604800000

# Build pipeline working directory (git clones + docker builds)
WORK_DIR=./data/builds

# Domain for user services (e.g. <slug>.localhost in dev, <slug>.yourdomain.com in prod)
WISP_DOMAIN=localhost

# Caddy admin API URL for dynamic route management
CADDY_ADMIN_URL=http://localhost:2019

# Docker network for service containers
DOCKER_NETWORK=wisp-net
