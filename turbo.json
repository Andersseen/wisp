{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "envMode": "loose",
  "tasks": {
    "db:generate": { "cache": false },
    "db:migrate": { "dependsOn": ["db:generate"], "cache": false },
    "db:seed": { "dependsOn": ["db:migrate"], "cache": false },
    "lint": { "outputs": [] },
    "check-types": { "outputs": [] },
    "test": { "outputs": [] },
    "test:e2e": { "dependsOn": ["build"], "cache": false },
    "build": { "dependsOn": ["^build", "db:generate"], "outputs": ["dist/**"] },
    "back:dev": { "cache": false, "persistent": true },
    "front:dev": { "cache": false, "persistent": true },
    "demo:dev": { "cache": false, "persistent": true },
    "demo:build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "start": { "cache": false }
  }
}
